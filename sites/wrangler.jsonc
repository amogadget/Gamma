// gammapdf.com — a static site served by Cloudflare Workers' static assets.
// Every request is answered from ./dist, which `npm run build` (build.mjs)
// assembles from ./site plus the repository's brand artwork and demos.
// `_redirects` and `_headers` inside ./site add the /download/* shortcuts and
// the cache/security headers. The only script (src/index.js) sends www to
// the apex, which `_redirects` cannot do (its sources must be relative), so
// it runs first and hands everything else to the assets binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gammapdf-site",
  "compatibility_date": "2026-09-01",
  "main": "src/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Both hostnames are Custom Domains of the Worker; the zone gammapdf.com
  // must already be on the Cloudflare account, or comment these out for a
  // first deploy to the *.workers.dev preview URL (sites/README.md).
  "routes": [
    { "pattern": "gammapdf.com", "custom_domain": true },
    { "pattern": "www.gammapdf.com", "custom_domain": true }
  ]
}

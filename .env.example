# Gamma — example environment file.
# Copy to `.env` (git-ignored) and fill in what you need. Docker Compose reads
# `.env` via `env_file:`; these are the app's full set of knobs.

# --- Data & serving ---------------------------------------------------------
# Where users.db and per-user data live. Defaults to ./data (repo root) when
# running from source; the Docker image sets it to /data (the mounted volume).
# GAMMA_DATA_DIR=./data

# Built frontend to serve as the SPA. Unset = API only. The Docker image sets
# this to /app/static; point it at frontend/dist to serve a local build.
# GAMMA_STATIC_DIR=

# Listen port (Docker entrypoint only; uvicorn reads its own --port).
# GAMMA_PORT=9001

# First-run admin seed: used ONLY while zero non-guest accounts exist. Leave
# unset to get a random password printed once to the container log.
# GAMMA_ADMIN_USER=admin
# GAMMA_ADMIN_PASSWORD=

# --- AI provider defaults (per-protocol base URLs) ---------------------------
# API keys are added per user in the GUI (Settings → AI providers); these only
# change each protocol's default base URL.
# GAMMA_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
# GAMMA_AI_OPENAI_BASE_URL=https://api.openai.com
# GAMMA_AI_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Hours a provider's auto-fetched model list stays fresh before re-fetch.
# GAMMA_AI_MODEL_CATALOG_TTL_HOURS=24

# --- Ownership of a bind-mounted data dir (linuxserver.io convention) --------
# With a bind mount (./data:/data) instead of a named volume, set these to your
# host user's ids (`id -u` / `id -g`) so Gamma's files belong to you, not root.
# PUID=1000
# PGID=1000

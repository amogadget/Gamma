{
  "name": "gamma-desktop",
  "productName": "Gamma",
  "version": "0.1.3",
  "description": "Gamma \u2014 a local PDF annotator with an outliner and an AI chat.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/*.test.mjs test/smoke.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "stage": "node scripts/stage-runtime.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "icon": "electron scripts/render-icon.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "com.amogadgetlab.gamma",
    "productName": "Gamma",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "supervisor.js",
      "config.js",
      "menu.js",
      "chooser/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "",
        "LSApplicationCategoryType": "public.app-category.productivity"
      },
      "identity": null,
      "icon": "assets/icon.png"
    },
    "dmg": {
      "title": "Gamma ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "AppImage"
        }
      ],
      "category": "Office",
      "synopsis": "PDF annotator with an outliner and an AI chat",
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "compression": "normal",
    "removePackageScripts": true,
    "npmRebuild": false,
    "publish": null,
    "afterPack": "scripts/afterPack.cjs"
  },
  "homepage": "https://github.com/amogadget/Gamma",
  "author": {
    "name": "amogadget",
    "email": "amogadget@users.noreply.github.com"
  },
  "desktopName": "gamma-desktop.desktop"
}

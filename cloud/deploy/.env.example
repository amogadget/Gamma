# Copy to .env next to compose.yml. Every value is read by the account server
# (cloud/gammacloud/config.py) except CADDY_HOST and TUNNEL_TOKEN, which the
# proxies read.

# The public address — the OIDC issuer every Gamma server verifies against.
GAMMA_CLOUD_PUBLIC_URL=https://account.gammapdf.com
GAMMA_CLOUD_DATA_DIR=/data

# open | invite | closed. Start with invite: `manage.py invite` makes codes.
GAMMA_CLOUD_REGISTRATION=invite

# Mail: verify, reset and change-e-mail links. Any SMTP submission service.
GAMMA_CLOUD_MAIL=smtp
GAMMA_CLOUD_MAIL_FROM=Gamma Cloud <no-reply@gammapdf.com>
GAMMA_CLOUD_SMTP_HOST=smtp.example.com
GAMMA_CLOUD_SMTP_PORT=587
GAMMA_CLOUD_SMTP_USER=
GAMMA_CLOUD_SMTP_PASSWORD=
GAMMA_CLOUD_SMTP_STARTTLS=1

# Cloudflare Turnstile (dashboard → Turnstile → add widget for the hostname).
# Leave both empty to run without the widget.
GAMMA_CLOUD_TURNSTILE_SITEKEY=
GAMMA_CLOUD_TURNSTILE_SECRET=

# Sign in with Google / GitHub (README.md → "Sign in with Google and GitHub").
# A provider is offered only when both of its values are set. Callbacks:
# <public url>/oauth/google/callback and <public url>/oauth/github/callback.
GAMMA_CLOUD_GOOGLE_CLIENT_ID=
GAMMA_CLOUD_GOOGLE_CLIENT_SECRET=
GAMMA_CLOUD_GOOGLE_ONE_TAP=1
GAMMA_CLOUD_GITHUB_CLIENT_ID=
GAMMA_CLOUD_GITHUB_CLIENT_SECRET=

# The built-in public OIDC client every local Gamma is (default gamma-desktop
# from config.py; normally unchanged).
GAMMA_CLOUD_DESKTOP_CLIENT_ID=

# The hostname Caddy serves (compose.yml): its DNS record must point at this
# host. Unused with compose.tunnel.yml.
CADDY_HOST=account.gammapdf.com

# Only with compose.tunnel.yml: the Cloudflare Tunnel connector token (Zero
# Trust → Networks → Tunnels); the tunnel's public hostname must point at
# http://account:9002.
TUNNEL_TOKEN=
